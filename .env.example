# 复制为 .env 后填写。API Key 也可以在网页「设置」里填写（加密保存在数据库中），两种方式任选。

# 服务
PORT=3200
# 本机使用保持 127.0.0.1；部署到服务器或服务器时改为 0.0.0.0，并务必设置访问密码
HOST=127.0.0.1
# 访问密码（设置后打开网站要先输入；用户名随意）
ARENA_PASSWORD=
# 加密 API Key 用的主密钥；不填则自动生成并保存在 data/secret.key
ARENA_SECRET=

# 各平台 API Key（可选，也可以在网页里填）
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ZAI_API_KEY=
ARK_API_KEY=
SILICONFLOW_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
